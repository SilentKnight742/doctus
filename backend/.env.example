# Copy to .env and fill in. .env is git-ignored; never commit it.
# Real environment variables take precedence over values in .env.

# Gemini API key (free tier works). Leave empty for offline use with DOCTUS_LLM=fake.
GEMINI_API_KEY=

# LLM provider: "gemini" or "fake" (offline, canned answers).
DOCTUS_LLM=gemini

# Gemini model name.
DOCTUS_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: a different Gemini model for the cartographer (graph updates).
# Empty means the same model as the chat.
DOCTUS_GRAPH_MODEL=

# SQLite database path.
DOCTUS_DB=doctus.db

# Max node/edge proposals the model may make per graph update.
DOCTUS_MAX_PROPOSALS=5

# Recent chat turns included as context in topic chat.
DOCTUS_RECENT_TURNS=8
